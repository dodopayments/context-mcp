{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dodo-knowledge-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // MCP is served statelessly (createMcpHandler). v2 deletes the old
  // per-session Durable Object class, which only held MCP session state.
  "migrations": [
    {
      "new_sqlite_classes": ["DodoKnowledgeMCP"],
      "tag": "v1"
    },
    {
      "deleted_classes": ["DodoKnowledgeMCP"],
      "tag": "v2"
    }
  ],

  // Environment variables (non-sensitive)
  "vars": {
    "PINECONE_INDEX_NAME": "dodo-knowledge-mcp",
    "EMBEDDING_PROVIDER": "openai",
    "EMBEDDING_MODEL": "text-embedding-3-large",
    "EMBEDDING_DIMENSIONS": "3072",
    "DEFAULT_TOP_K": "10",
    "MAX_TOP_K": "20",

    // Reranking configuration
    "ENABLE_RERANK": "true",
    "RERANK_MODEL": "pinecone-rerank-v0",
    "RERANK_FETCH_COUNT": "30",
    "MAX_RERANK_CHARS": "1200",
    "GITHUB_SCORE_FACTOR": "0.8"
  },

  // Enable observability
  "observability": {
    "enabled": true
  }
}

